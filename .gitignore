# ===== Python 运行产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
seat-env/

# ===== 模型权重与训练输出（体积大，不进仓库）=====
models/*.pt
models/*.onnx
models/*.engine
runs/
weights/
*.pth
*.ckpt

# ===== 数据集（图片与标注，体积大，不进仓库）=====
data/raw/*
data/labels/*
data/images/*
data/seat_dataset/
data/*.db
data/exports/
!data/raw/.gitkeep
!data/labels/.gitkeep
!data/images/.gitkeep

# 演示素材（含网络图片，仅存本地，不上传仓库）
data/video_demo/

# 标注工作区与预标注产物（含网络图片，仅存本地）
data/workspace/
data/prelabel_preview/
data/verify_preview/

# 上传的视频（处理后即删，仅本地缓存）
data/uploads/

# ===== 日志与临时文件 =====
logs/*
!logs/.gitkeep
*.log
*.tmp
~$*

# ===== 编辑器与系统文件 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ===== 本地配置与密钥（可能含摄像头密码）=====
config/config.local.yaml
.env
*.key

# 真实素材与核对预览（含个人照片，仅存本地）
data/raw_real/
data/prelabel_review/
output/
